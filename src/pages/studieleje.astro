---
import MainLayout from "../layouts/MainLayout.astro";
import Button from "../components/Button.astro";
---

<MainLayout
  title="Kadaver | Studieleje"
  description="Kadaver - studieleje"
  ogtitle="Kadaver - studieleje-side"
  ogdescription="Kadaver's studieleje-side"
>
  <section class="top-section relative md:pt-desktop-top pt-mobil-top md:pb-desktop-bottom pb-mobil-bottom w-full h-screen">
    <!-- Video Background -->
    <div class="absolute inset-0 w-full h-full z-0">
      <video
        src="/images/studio_video.mp4"
        aria-label="timelapse-video til hero-sektionen af Kadaver's studieleje-side"
        class="w-full h-screen object-cover brightness-[0.7] grayscale"
        autoplay
        loop
        muted></video>
      <div class="overlay absolute inset-0 bg-gray-950 backdrop-blur-[2px] bg-opacity-60 z-10 md:w-[50%]"></div>
    </div>

    <!-- Text Overlay -->
    <div class="absolute inset-0 max-w-7xl mx-auto md:px-0 px-8 z-20 grid grid-cols-12 content-center h-full">
      <div class="md:col-span-8 col-span-12 text-left flex flex-col justify-center items-start z-30">
        <h1 class="display mb-4 text-gray-50">Studieleje</h1>
        <hr class="border-violet-600 border-4 w-[195px] md:w-[335px] md:mb-8 mb-10" />
      </div>
      <div class="btn_container flex flex-row pt-8 gap-6 md:gap-12 col-span-12">
        <a href="#contact" aria-label="Gå til kontakt">
          <Button variant="primary" size="small">Gå til kontakt</Button>
        </a>
      </div>
    </div>
    <div class="arrow absolute bottom-[3%] md:bottom-[2.5%] w-full flex justify-center z-[30]">
      <a href="#info-list" aria-label="Gå længere ned ad siden">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="arrow float w-8 h-8 sm:w-10 sm:h-10 text-gray-50 hover:text-violet-600 transition duration-300 ease-in-out"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
        </svg>
      </a>
    </div>
  </section>

  <section
    id="info-list"
    class="info_list md:pt-24 pt-12 md:pb-desktop-bottom pb-mobil-bottom max-w-7xl mx-auto px-8 grid grid-cols-1 lg:grid-cols-3 gap-12"
  >
    <h2 class="md:text-h2-desktop text-h3-mobile col-span-3 md:mb-2 mb-4">Alt du skal vide om studiet</h2>
    <div class="bg-[#e9e9e9] p-6 rounded-[5px]">
      <div class="flex items-center mb-4">
        <img src="/images/mandatory.webp" alt="Obligatorisk info" class="w-12 h-12 mr-4 rounded-full object-cover" />
        <h3 class="md:text-h4-desktop text-h4-mobile">Obligatorisk</h3>
      </div>
      <table class="w-full">
        <tbody class="divide-y divide-gray-300">
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Beliggenhed</td>
            <td class="p-4 text-gray-600 text-[15px]">Wilders Plads 5, <br class="hidden md:block" /> 1403 København K</td>
          </tr>
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Pris pr. dag</td>
            <td class="p-4 text-gray-600 text-[15px]">2950,- ekskl. moms</td>
          </tr>
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Tidsrum</td>
            <td class="p-4 text-gray-600 text-[15px]">8-17</td>
          </tr>
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Areal</td>
            <td class="p-4 text-gray-600 text-[15px]">40 m2 + klippestudie på 12,5 m2</td>
          </tr>
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Højde</td>
            <td class="p-4 text-gray-600 text-[15px]">3 m</td>
          </tr>
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Rumhorisont</td>
            <td class="p-4 text-gray-600 text-[15px]">18 m2 <br class="hidden md:block" /><em>(kan males efter aftale)</em></td>
          </tr>
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Adgang</td>
            <td class="p-4 text-gray-600 text-[15px]">Direkte fra parkeringsplads i stueplan</td>
          </tr>
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Internet</td>
            <td class="p-4 text-gray-600 text-[15px]">Ja</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Card 2: Optional Info -->
    <div class="bg-[#e9e9e9] p-6 rounded-[5px]">
      <div class="flex items-center mb-4">
        <img src="/images/technical.webp" alt="Valgfrit info" class="w-12 h-12 mr-4 rounded-full object-cover" />
        <h3 class="md:text-h4-desktop text-h4-mobile">Teknisk</h3>
      </div>
      <table class="w-full">
        <tbody class="divide-y divide-gray-300">
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Green-screen</td>
            <td class="p-4 text-gray-600 text-[15px]">Ja</td>
          </tr>
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Baggrunde</td>
            <td class="p-4 text-gray-600 text-[15px]">Ja, mange forskellige farver</td>
          </tr>
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Lydisoleret</td>
            <td class="p-4 text-gray-600 text-[15px]">Delvist</td>
          </tr>
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Akustisk behandlet</td>
            <td class="p-4 text-gray-600 text-[15px]">Ja</td>
          </tr>
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Mulighed for mørklægning</td>
            <td class="p-4 text-gray-600 text-[15px]">Ja</td>
          </tr>
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Lys</td>
            <td class="p-4 text-gray-600 text-[15px]">Mulighed for opsætning i loft- og standerlamper</td>
          </tr>
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">El</td>
            <td class="p-4 text-gray-600 text-[15px]">18 amp udtag</td>
          </tr>
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Musikanlæg</td>
            <td class="p-4 text-gray-600 text-[15px]">Ja</td>
          </tr>
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Makeup-station</td>
            <td class="p-4 text-gray-600 text-[15px]">Ja</td>
          </tr>
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Lounge</td>
            <td class="p-4 text-gray-600 text-[15px]">Ja</td>
          </tr>
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Tekøkken</td>
            <td class="p-4 text-gray-600 text-[15px]">Ja</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Card 3: Other Info -->
    <div class="bg-[#e9e9e9] p-6 rounded-[5px]">
      <div class="flex items-center mb-4">
        <img src="/images/rent.webp" alt="Andet info" class="w-12 h-12 mr-4 rounded-full object-cover" />
        <h3 class="md:text-h4-desktop text-h4-mobile">Udstyrsleje</h3>
      </div>
      <table class="w-full">
        <tbody class="divide-y divide-gray-300">
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Kamera</td>
            <td class="p-4 text-gray-600 text-[15px]"
              >Sony a7s iii + Atomos Ninja V recorder inkl. diske: <span class="font-bold underline">800 kr. pr. dag</span></td
            >
          </tr>
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Objektiv</td>
            <td class="p-4 text-gray-600 text-[15px]"
              >SONY (E) FE 28-135MM F/4 PZ G OSS Ø95: <span class="font-bold underline">500 kr. pr. dag</span></td
            >
          </tr>
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Gimbal</td>
            <td class="p-4 text-gray-600 text-[15px]">ZHIYUN CRANE 3S: <span class="font-bold underline">500 kr. pr. dag</span></td>
          </tr>
          <tr>
            <td class="p-4 text-[15px] font-gilroy-bold">Lys</td>
            <td class="p-4 text-gray-600 text-[15px]">
              <ul class="list-disc pl-4 space-y-2">
                <li class="text-gray-600 text-[15px]">5 x Area 48 LED: <span class="font-gilroy-bold underline">250 kr. pr. dag</span></li>
                <li class="text-gray-600 text-[15px]">
                  1 x Soft boks Nanlite Compac 200B: <span class="font-gilroy-bold underline">250 kr. pr. dag</span>
                </li>
                <li class="text-gray-600 text-[15px]">
                  2 x Boling LED Slim line BL-2280P + 5500 Kelvin: <span class="font-gilroy-bold underline">200 kr. pr. stk. pr. dag</span>
                </li>
                <li class="text-gray-600 text-[15px]">
                  Diverse lysstofrør og stativer: <span class="font-gilroy-bold underline">pris efter aftale</span>
                </li>
              </ul>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="image-section md:pb-desktop-bottom pb-mobil-bottom max-w-7xl mx-auto px-8 grid grid-cols-12 gap-4 items-start">
    <div class="image1 col-span-12 md:col-span-7">
      <img src="/images/sr_section1.webp" alt="produktbillede 1 (kampagne: enter the gamer)" class="w-full h-[497px] object-cover" />
    </div>
    <div class="images2 col-span-12 md:col-span-5 flex flex-wrap gap-4">
      <img src="/images/sr_section2.webp" alt="produktbillede 2 (kampagne: sabaah)" class="w-[48%] md:w-[47%] h-[240px] object-cover" />
      <img src="/images/sr_section3.webp" alt="produktbillede 3 (kampagne: little live pets)" class="w-[48%] md:w-[47%] h-[240px] object-cover" />
      <img src="/images/sr_section4.webp" alt="produktbillede 4 (kampagne: lenovo)" class="w-[48%] md:w-[47%] h-[240px] object-cover" />
      <img src="/images/sr_section5.webp" alt="produktbillede 5 (kampagne: lenovo)" class="w-[48%] md:w-[47%] h-[240px] object-cover" />
    </div>
  </section>

  <section
    id="contact"
    class="contact md:pb-desktop-bottom pb-mobil-bottom max-w-7xl mx-auto md:px-0 px-8 grid grid-cols-12 gap-6 md:gap-12 items-center"
  >
    <div class="contact_text md:col-span-7 col-span-12 md:col-start-2 flex flex-col justify-center md:items-start">
      <h3 class="pb-2 md:pb-4">Kontakt</h3>
      <p class="pb-2 md:pb-4">
        Hvis du har spørgsmål om leje eller har brug for yderligere information omkring vores studie, er du velkommen til at kontakte Carl Johannes
        Borris på: <br /><br />
        <span
          ><a aria-label="Kontakt Borris" href="mailto:borris@kadaver.dk" class="email">borris@kadaver.dk</a><br /><a
            href="tel:+4526365015"
            class="phone">+45 2636 5015</a
          ></span
        >
      </p>
    </div>
    <div class="contact_image hidden md:block col-span-8 md:col-span-3 md:justify-center">
      <img
        src="/images/borris_contact.svg"
        alt="Billede-grafik af Borris"
        class="hover:-translate-y-2 transition duration-300 ease-in-out w-[290px] h-[386.77px]"
      />
    </div>
  </section>
</MainLayout>

<script>
  import { inView } from "motion";

  /* inView Animations */
  const elementmedanimation1 = document.querySelector("h1");
  inView(elementmedanimation1, () => {
    elementmedanimation1.classList.add("animate__animated", "animate__fadeInRight");
  });

  const elementmedanimation2 = document.querySelector("hr");
  inView(elementmedanimation2, () => {
    elementmedanimation2.classList.add("animate__animated", "animate__fadeInRight");
  });

  const elementmedanimation3 = document.querySelector(".image");
  inView(elementmedanimation3, () => {
    elementmedanimation3.classList.add("animate__animated", "animate__fadeInDown");
  });

  const elementmedanimation4 = document.querySelector("h2");
  inView(elementmedanimation4, () => {
    elementmedanimation4.classList.add("animate__animated", "animate__fadeInLeft");
  });

  const columns = document.querySelectorAll(".info_list > div");

  columns.forEach((column, index) => {
    inView(column, () => {
      column.classList.add("animate__animated", "animate__fadeInLeft");
      column.style.animationDelay = `${index * 400}ms`; // Delay each column by 0.2s
    });
  });

  const elementmedanimation5 = document.querySelector(".image1");
  inView(elementmedanimation5, () => {
    elementmedanimation5.classList.add("animate__animated", "animate__fadeInLeft");
  });

  const img = document.querySelectorAll(".images2 > img");

  img.forEach((imgs, index) => {
    inView(imgs, () => {
      imgs.style.animationDelay = `${index * 400}ms`; // Ensure delay is set before animation
      imgs.classList.add("animate__animated", "animate__fadeInRight");
    });
  });

  const elementmedanimation6 = document.querySelector(".contact_text");
  inView(elementmedanimation6, () => {
    elementmedanimation6.classList.add("animate__animated", "animate__fadeInLeft");
  });

  const elementmedanimation7 = document.querySelector(".contact_image");
  inView(elementmedanimation7, () => {
    elementmedanimation7.classList.add("animate__animated", "animate__fadeInRight");
  });

  const elementmedanimation8 = document.querySelector(".hero_text");
  inView(elementmedanimation8, () => {
    elementmedanimation8.classList.add("animate__animated", "animate__fadeInRight");
  });

  const elementmedanimation9 = document.querySelector(".btn_container");
  inView(elementmedanimation9, () => {
    elementmedanimation9.classList.add("animate__animated", "animate__zoomIn");
  });

  const elementmedanimation10 = document.querySelector(".overlay");
  inView(elementmedanimation10, () => {
    elementmedanimation10.classList.add("animate__animated", "animate__fadeInLeft");
  });
</script>

<style>
  @keyframes float {
    0% {
      transform: translatey(0);
    }
    50% {
      transform: translatey(-10px);
    }
    100% {
      transform: translatey(0);
    }
  }
  .float {
    animation: float 3s ease-in-out infinite;
  }
</style>
