---
import MainLayout from "../layouts/MainLayout.astro";
import Button from "../components/Button.astro";
---

<MainLayout
  title="Kadaver | Studieleje"
  description="Kadaver - studieleje"
  ogtitle="Kadaver - studieleje-side"
  ogdescription="Kadaver's studieleje-side"
>
  <section class="top-section relative md:pt-desktop-top pt-mobil-top md:pb-desktop-bottom pb-mobil-bottom w-full h-screen">
    <!-- Video Background -->
    <div class="absolute inset-0 w-full h-full z-0">
      <video
        src="/images/studio_video.mp4"
        aria-label="timelapse-video til hero-sektionen af Kadaver's studieleje-side"
        class="w-full h-screen object-cover brightness-[0.5] grayscale"
        autoplay
        loop
        muted></video>
      <div class="absolute inset-0 bg-gray-950 backdrop-blur-sm bg-opacity-60 z-10 md:w-[50%]"></div>
    </div>

    <!-- Text Overlay -->
    <div class="absolute inset-0 max-w-7xl mx-auto md:px-0 px-8 z-20 grid grid-cols-12 content-center h-full">
      <div class="md:col-span-8 col-span-12 text-left flex flex-col justify-center items-start z-30">
        <h1 class="display mb-4 text-gray-50">Studieleje</h1>
        <hr class="border-violet-600 border-4 w-[195px] md:w-[335px] md:mb-8 mb-10" />
        <p class="hero_text text-gray-50">
          Har du brug for et kreativt rum til dit næste projekt? Vores studie er udstyret med alt du behøver, fra green screen til
          makeupstation&mdash; perfekt til både fotoshoots og videoproduktioner. Book din næste session hos os og få den professionelle ramme, som du
          søger.
        </p>
      </div>
      <div class="btn_container flex flex-row pt-8 gap-6 md:gap-12 col-span-12">
        <a href="#contact" aria-label="Gå til kontakt">
          <Button variant="primary" size="small">Gå til kontakt</Button>
        </a>
      </div>
    </div>
    <div class="arrow absolute bottom-[3%] md:bottom-[2.5%] w-full flex justify-center z-[30]">
      <a href="#info-list" aria-label="Gå længere ned ad siden">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="arrow float w-8 h-8 sm:w-10 sm:h-10 text-gray-50 hover:text-violet-600 transition duration-300 ease-in-out"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
        </svg>
      </a>
    </div>
  </section>

  <section
    id="info-list"
    class="info_list md:pt-desktop-top pt-mobil-top md:pb-desktop-bottom mb-mobile-bottom max-w-7xl mx-auto md:px-0 px-8 grid grid-cols-12 gap-6 md:gap-12"
  >
    <div class="col-span-12">
      <h2 class="md:text-h2-desktop text-h3-mobile md:mb-12 mb-4">Alt du skal vide</h2>
      <div class="list grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Obligatory Table -->
        <div class="flex flex-col">
          <img src="/images/mandatory.webp" class="w-full object-cover" alt="Obligatorisk info" />
          <h3 class="md:text-h3-desktop text-h4-mobile md:mt-8 mt-6 md:mb-4 mb-2">Obligatorisk</h3>
          <table class="w-full border-collapse border border-gray-950">
            <tbody>
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Beliggenhed</td><td class="p-4">Wilders Plads 5, 1403 KBH K</td></tr
              >
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Pris pr. dag</td><td class="p-4">2950,- kr. ekskl. moms</td></tr
              >
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Tidsrum</td><td class="p-4">8-17</td></tr
              >
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Areal</td><td class="p-4">40 m2 + klippestudie på 12,5 m2</td></tr
              >
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Højde</td><td class="p-4">3 m</td></tr
              >
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Rumhorisont</td><td class="p-4"
                  >18 m2 <em>(kan males efter aftale)</em></td
                ></tr
              >
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Adgang</td><td class="p-4">Direkte fra parkeringsplads i stueplan</td
                ></tr
              >
              <tr><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Internet</td><td class="p-4">Ja</td></tr>
            </tbody>
          </table>
        </div>

        <!-- Technical Table -->
        <div class="flex flex-col">
          <img src="/images/technical.webp" class="w-full object-cover" alt="Teknisk info" />
          <h3 class="md:text-h3-desktop text-h4-mobile md:mt-8 mt-5 md:mb-4 mb-2">Teknisk</h3>
          <table class="w-full border-collapse border border-gray-950">
            <tbody>
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Green-screen</td><td class="p-4">Ja</td></tr
              >
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Baggrunde</td><td class="p-4">Ja, mange forskellige farver</td></tr
              >
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Lydisoleret</td><td class="p-4">Delvist</td></tr
              >
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Akustisk behandlet</td><td class="p-4">Ja</td></tr
              >
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Mulighed for mørklægning</td><td class="p-4">Ja</td></tr
              >
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Lys</td><td class="p-4"
                  >Mulighed for opsætning i loft- og standerlamper</td
                ></tr
              >
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">El</td><td class="p-4">18 amp udtag</td></tr
              >
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Musikanlæg</td><td class="p-4">Ja</td></tr
              >
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Makeup-station</td><td class="p-4">Ja</td></tr
              >
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Lounge</td><td class="p-4">Ja</td></tr
              >
              <tr><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Tekøkken</td><td class="p-4">Ja</td></tr>
            </tbody>
          </table>
        </div>

        <!-- Rental Table -->
        <div class="flex flex-col">
          <img src="/images/rent.webp" class="w-full object-cover" alt="Udstyrsleje" />
          <h3 class="md:text-h3-desktop text-h4-mobile md:mt-8 mt-5 md:mb-4 mb-2">Udstyrsleje</h3>
          <table class="w-full border-collapse border border-gray-950">
            <tbody>
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Kamera</td><td class="p-4"
                  >Sony a7s iii + Atomos Ninja V recorder inkl. diske: <span class="bold underline">800 kr. pr. dag</span></td
                ></tr
              >
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Objektiv</td><td class="p-4"
                  >SONY (E) FE 28-135MM F/4 PZ G OSS Ø95: <span class="bold underline">500 kr. pr. dag</span></td
                ></tr
              >
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Gimbal</td><td class="p-4"
                  >ZHIYUN CRANE 3S: <span class="bold underline">500 kr. pr. dag</span></td
                ></tr
              >
              <tr class="border-b border-gray-950"
                ><td class="p-4 font-bold border-r border-gray-950 bg-gray-100">Lys</td><td class="p-4">
                  <ul class="list-disc pl-4 space-y-2">
                    <li>5 x Area 48 LED: <span class="bold underline">250 kr. pr. dag</span></li>
                    <li>1 x Soft boks Nanlite Compac 200B: <span class="bold underline">250 kr. pr. dag</span></li>
                    <li>
                      2 x Boling LED Slim line BL-2280P + 5500 Kelvin: <span class="bold underline">200 kr. pr. stk. pr. dag</span>
                    </li>
                    <li>Diverse lysstofrør og stativer: <span class="bold underline">pris efter aftale</span></li>
                  </ul>
                </td></tr
              >
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="image-section md:pb-desktop-bottom pb-mobil-bottom max-w-7xl mx-auto md:px-0 px-8 grid grid-cols-12 gap-4 items-start">
    <div class="image1 col-span-12 md:col-span-7">
      <img src="/images/sr_section1.webp" alt="produktbillede 1 (kampagne: enter the gamer)" class="w-full h-[497px] object-cover" />
    </div>
    <div class="images2 col-span-12 md:col-span-5 flex flex-wrap gap-4">
      <img src="/images/sr_section2.webp" alt="produktbillede 2 (kampagne: sabaah)" class="w-[48%] md:w-[47%] h-[240px] object-cover" />
      <img src="/images/sr_section3.webp" alt="produktbillede 3 (kampagne: little live pets)" class="w-[48%] md:w-[47%] h-[240px] object-cover" />
      <img src="/images/sr_section4.webp" alt="produktbillede 4 (kampagne: lenovo)" class="w-[48%] md:w-[47%] h-[240px] object-cover" />
      <img src="/images/sr_section5.webp" alt="produktbillede 5 (kampagne: lenovo)" class="w-[48%] md:w-[47%] h-[240px] object-cover" />
    </div>
  </section>

  <section
    id="contact"
    class="contact md:pb-desktop-bottom pb-mobil-bottom max-w-7xl mx-auto md:px-0 px-8 grid grid-cols-12 gap-6 md:gap-12 items-center"
  >
    <div class="contact_text md:col-span-7 col-span-12 md:col-start-2 flex flex-col justify-center md:items-start">
      <h3 class="pb-2 md:pb-4">Kontakt</h3>
      <p class="pb-2 md:pb-4">
        Hvis du har spørgsmål om leje eller har brug for yderligere information omkring vores studie, er du velkommen til at kontakte Carl Johannes
        Borris på: <br /><br />
        <span
          ><a aria-label="Kontakt Borris" href="mailto:borris@kadaver.dk" class="email">borris@kadaver.dk</a><br /><a
            href="tel:+4526365015"
            class="phone">+45 2636 5015</a
          ></span
        >
      </p>
    </div>
    <div class="contact_image hidden md:block col-span-8 md:col-span-3 md:justify-center">
      <img
        src="/images/borris_contact.svg"
        alt="Billede-grafik af Borris"
        class="hover:-translate-y-2 transition duration-300 ease-in-out w-[290px] h-[386.77px]"
      />
    </div>
  </section>
</MainLayout>

<script>
  import { inView } from "motion";

  /* inView Animations */
  const elementmedanimation1 = document.querySelector("h1");
  inView(elementmedanimation1, () => {
    elementmedanimation1.classList.add("animate__animated", "animate__fadeInRight");
  });

  const elementmedanimation2 = document.querySelector("hr");
  inView(elementmedanimation2, () => {
    elementmedanimation2.classList.add("animate__animated", "animate__fadeInRight");
  });

  const elementmedanimation3 = document.querySelector(".image");
  inView(elementmedanimation3, () => {
    elementmedanimation3.classList.add("animate__animated", "animate__fadeInDown");
  });

  const elementmedanimation4 = document.querySelector("h2");
  inView(elementmedanimation4, () => {
    elementmedanimation4.classList.add("animate__animated", "animate__fadeInLeft");
  });

  const columns = document.querySelectorAll(".list > div");

  columns.forEach((column, index) => {
    inView(column, () => {
      column.classList.add("animate__animated", "animate__fadeInLeft");
      column.style.animationDelay = `${index * 400}ms`; // Delay each column by 0.2s
    });
  });

  const elementmedanimation5 = document.querySelector(".image1");
  inView(elementmedanimation5, () => {
    elementmedanimation5.classList.add("animate__animated", "animate__fadeInLeft");
  });

  const img = document.querySelectorAll(".images2 > img");

  img.forEach((imgs, index) => {
    inView(imgs, () => {
      imgs.style.animationDelay = `${index * 400}ms`; // Ensure delay is set before animation
      imgs.classList.add("animate__animated", "animate__fadeInRight");
    });
  });

  const elementmedanimation6 = document.querySelector(".contact_text");
  inView(elementmedanimation6, () => {
    elementmedanimation6.classList.add("animate__animated", "animate__fadeInLeft");
  });

  const elementmedanimation7 = document.querySelector(".contact_image");
  inView(elementmedanimation7, () => {
    elementmedanimation7.classList.add("animate__animated", "animate__fadeInRight");
  });

  const elementmedanimation8 = document.querySelector(".hero_text");
  inView(elementmedanimation8, () => {
    elementmedanimation8.classList.add("animate__animated", "animate__fadeInRight");
  });

  const elementmedanimation9 = document.querySelector(".btn_container");
  inView(elementmedanimation9, () => {
    elementmedanimation9.classList.add("animate__animated", "animate__zoomIn");
  });
</script>

<style>
  @keyframes float {
    0% {
      transform: translatey(0);
    }
    50% {
      transform: translatey(-10px);
    }
    100% {
      transform: translatey(0);
    }
  }
  .float {
    animation: float 3s ease-in-out infinite;
  }
</style>
