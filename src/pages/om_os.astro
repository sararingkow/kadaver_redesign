---
import MainLayout from "../layouts/MainLayout.astro";
import Button from "../components/Button.astro";
---

<MainLayout title="Kadaver | Om os" description="Kadaver - om os" ogtitle="Kadaver - om os side" ogdescription="Kadaver's om os side">
  <section class="top-section relative md:pb-desktop-bottom pb-mobil-bottom w-full h-screen">
    <!-- Video Background -->
    <div class="absolute inset-0 w-full h-full z-0">
      <img
        src="/images/au_page.webp"
        alt="billede til hero-sektionen af Kadaver's 'om os'-side"
        class="w-full h-screen object-cover brightness-[0.7] grayscale"
      />
      <div class="overlay absolute inset-0 bg-gray-950 backdrop-blur-[2px] bg-opacity-60 z-10 md:w-[50%]"></div>
    </div>

    <!-- Text Overlay -->
    <div class="absolute inset-0 max-w-7xl mx-auto md:px-0 px-8 z-20 grid grid-cols-12 content-center h-full">
      <div class="md:col-span-8 col-span-12 text-left flex flex-col justify-center items-start z-30">
        <h1 class="display mb-4 text-gray-50">Om os</h1>
        <hr class="border-violet-600 border-4 w-[100px] md:w-[180px] md:mb-8 mb-10" />
      </div>
      <div class="btn_container flex flex-row pt-12 gap-6 md:gap-12 col-span-12">
        <a href="#contact" aria-label="Gå til kontakt">
          <Button variant="primary" size="small">Gå til kontakt</Button>
        </a>
      </div>
    </div>
    <div class="absolute bottom-[3%] md:bottom-[2.5%] w-full flex justify-center z-[30]">
      <a href="#info-section" aria-label="Gå længere ned ad siden">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="arrow float w-8 h-8 sm:w-10 sm:h-10 text-gray-50 hover:text-violet-600 transition duration-300 ease-in-out"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
        </svg>
      </a>
    </div>
  </section>
  <section
    id="info-section"
    class="info_section pt-mobil-top md:pt-desktop-top max-w-7xl mx-auto md:px-0 px-8 grid grid-cols-12 gap-6 md:gap-12 items-center"
  >
    <div class="text_left col-span-12 md:col-span-9 max-w-4xl">
      <h2 class="text-h3-mobile md:text-h3-desktop pb-0 md:pb-4">Kadaver – et resultatdrevet brand- & contentbureau</h2>
      <p class="md:pb-0 pb-8">
        Vi skaber oplevelser, der inspirerer og engagerer. Hos Kadaver dykker vi ned i hver eneste detalje for at finde de historier, værdier og
        unikke kendetegn, der giver et brand karakter. Det er vores kreative drivkraft.
        <br /><br />
        Med en strategisk tilgang omsætter vi indsigt til stærke kampagner, der ikke bare fanger opmærksomhed, men også skaber ægte forbindelser og målbare
        resultater. Vi kombinerer kreativitet med handling&mdash; vi underholder, vi inspirerer, og vi bygger relationer, der holder.
        <br /><br />
        <span
          >For os handler det ikke om at jagte trends, men om at forme fortællinger, der føles <br class="hidden md:block" />ægte og giver mening.</span
        >
      </p>
    </div>
    <div class="logo hidden md:block col-span-12 md:col-span-3 md:justify-center justify-start items-center md:pb-0 pb-10">
      <img src="/images/logo_gradient.webp" alt="gradient-logo for Kadaver" class="md:w-52 md:h-52 w-40 h-40" />
    </div>
  </section>

  <section
    class="service_section md:pt-desktop-top pt-mobil-top pb-mobil-bottom md:pb-desktop-bottom max-w-7xl mx-auto md:px-0 px-8 grid grid-cols-12 gap-6 md:gap-12 items-center"
  >
    <div class="md:col-span-10 col-span-12 md:col-start-2 items-center justify-center">
      <h2 class="service_title text-h3-mobile md:text-h3-desktop col-span-12 md:text-left text-center pb-0 md:pb-2">Vores ydelser</h2>
      <h3 class="service_subtitle md:text-h4-desktop text-h4-mobile md:pt-0 pt-2 pb-12 md:pb-14 text-gray-700 md:text-left text-center">
        Se dem i aktion i vores cases
      </h3>
      <div class="service_images flex flex-col md:flex-row gap-12 items-center justify-center">
        <div class="w-full flex justify-center">
          <a href="/listview" class="service-link">
            <img
              src="/images/ydelser1.svg"
              alt="Design"
              class="service-image hover:-translate-y-2 transition duration-300 ease-in-out md:w-40 w-32"
            />
          </a>
        </div>
        <div class="w-full flex justify-center">
          <a href="/listview" class="service-link">
            <img
              src="/images/ydelser2.svg"
              alt="Events"
              class="service-image hover:-translate-y-2 transition duration-300 ease-in-out md:w-40 w-32"
            />
          </a>
        </div>
        <div class="w-full flex justify-center">
          <a href="/listview" class="service-link">
            <img src="/images/ydelser3.svg" alt="Film" class="service-image hover:-translate-y-2 transition duration-300 ease-in-out md:w-40 w-32" />
          </a>
        </div>
        <div class="w-full flex justify-center">
          <a href="/listview" class="service-link">
            <img
              src="/images/ydelser4.svg"
              alt="Socials"
              class="service-image hover:-translate-y-2 transition duration-300 ease-in-out md:w-40 w-32"
            />
          </a>
        </div>
        <div class="w-full flex justify-center">
          <a href="/listview" class="service-link">
            <img
              src="/images/ydelser5.svg"
              alt="Campaign"
              class="service-image hover:-translate-y-2 transition duration-300 ease-in-out md:w-40 w-32"
            />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="work_section flex justify-center items-center pb-mobil-bottom md:pb-desktop-bottom">
    <div class="work_container mx-auto md:px-0 px-8 grid grid-cols-12 gap-6 items-center justify-center">
      <h2 class="col-span-12 pb-0 md:pb-4 text-h3-mobile md:text-h3-desktop">Vores arbejde i praksis</h2>
      <div class="col-span-12">
        <p>
          Vi tror på, at kreative løsninger starter med stærke idéer. Udforsk vores cases, og se<br class="hidden md:block" />
          hvordan vi har hjulpet brands med at formidle deres historier på nye og inspirerende <br class="hidden md:block" />
          måder.
        </p>
        <div class="btn_container md:pt-5 pt-6 md:pb-12 pb-8">
          <a href="/listview" aria-label="Udforsk cases">
            <Button variant="secondary" size="small">Udforsk cases</Button>
          </a>
        </div>
        <img
          src="/images/top_cases.webp"
          alt="screenshot af cases fra den nuværende Kadaver-hjemmeside"
          class="work_image w-full h-auto object-cover"
        />
      </div>
    </div>
  </section>
</MainLayout>

<script>
  import { inView } from "motion";

  /* inView Animations */
  const elementmedanimation1 = document.querySelector("h1");
  inView(elementmedanimation1, () => {
    elementmedanimation1.classList.add("animate__animated", "animate__fadeInRight");
  });

  const elementmedanimation2 = document.querySelector("hr");
  inView(elementmedanimation2, () => {
    elementmedanimation2.classList.add("animate__animated", "animate__fadeInRight");
  });

  const elementmedanimation3 = document.querySelector(".text_left");
  inView(elementmedanimation3, () => {
    elementmedanimation3.classList.add("animate__animated", "animate__fadeInLeft");
  });

  const elementmedanimation4 = document.querySelector(".logo");
  inView(elementmedanimation4, () => {
    elementmedanimation4.classList.add("animate__animated", "animate__fadeInRight");
  });

  const elementmedanimation5 = document.querySelector(".service_images");
  inView(elementmedanimation5, () => {
    elementmedanimation5.classList.add("animate__animated", "animate__flipInX");
  });

  const elementmedanimation6 = document.querySelector(".work_container");
  inView(elementmedanimation6, () => {
    elementmedanimation6.classList.add("animate__animated", "animate__fadeInUp");
  });

  const elementmedanimation7 = document.querySelector(".work_image");
  inView(elementmedanimation7, () => {
    elementmedanimation7.classList.add("animate__animated", "animate__fadeInLeft");
  });

  const elementmedanimation8 = document.querySelector(".btn_container");
  inView(elementmedanimation8, () => {
    elementmedanimation8.classList.add("animate__animated", "animate__zoomIn");
  });

  const elementmedanimation10 = document.querySelector(".service_title");
  inView(elementmedanimation10, () => {
    elementmedanimation10.classList.add("animate__animated", "animate__fadeInRight");
  });

  const elementmedanimation10a = document.querySelector(".service_subtitle");
  inView(elementmedanimation10a, () => {
    elementmedanimation10a.classList.add("animate__animated", "animate__fadeInLeft");
  });

  const elementmedanimation11 = document.querySelector(".overlay");
  inView(elementmedanimation11, () => {
    elementmedanimation11.classList.add("animate__animated", "animate__fadeInLeft");
  });
</script>

<style>
  @keyframes float {
    0% {
      transform: translatey(0);
    }
    50% {
      transform: translatey(-10px);
    }
    100% {
      transform: translatey(0);
    }
  }
  .float {
    animation: float 3s ease-in-out infinite;
  }
</style>
